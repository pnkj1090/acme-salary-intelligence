# ==============================================================================
# ACME Salary Intelligence — Environment Configuration Template
# ==============================================================================

# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Application Environment: 'development', 'test', 'production'
ENVIRONMENT=development

# Database Connection URL:
# For SQLite local development:
DATABASE_URL=sqlite:///./acme_salary.db
# For PostgreSQL production deployment (e.g. Amazon RDS PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/acme_salary?sslmode=require

# Allowed CORS Origins (comma-separated):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Host & Port
HOST=127.0.0.1
PORT=8000


# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# API Base URL for React app.
# In local development with Vite dev server proxying '/api', leave empty:
VITE_API_BASE_URL=
# In production on AWS, API is served same-origin under '/api' via CloudFront (or specify CDN origin):
# VITE_API_BASE_URL=https://d1gy9op4wnx31d.cloudfront.net
